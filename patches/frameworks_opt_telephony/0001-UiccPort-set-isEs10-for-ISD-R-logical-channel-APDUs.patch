+    private boolean isEs10Channel(int channel) {
+        OpenLogicalChannelRecord record = getOpenLogicalChannelRecord(channel);
+        if (record == null || record.mRequest == null || record.mRequest.aid == null) {
+            return false;
+        }
+        return record.mRequest.aid.toUpperCase(java.util.Locale.ROOT)
+                .startsWith("A0000005591010");
+    }
+
+    private String maybeAddMepA1TargetPort(String data) {
+        if (data == null || data.length() < 8
+                || !data.regionMatches(true, 0, "BF31", 0, 4)) {
+            return data;
+        }
+        IccSlotStatus.MultipleEnabledProfilesMode mepMode = null;
+        if (this instanceof com.android.internal.telephony.uicc.euicc.EuiccPort) {
+            mepMode = ((com.android.internal.telephony.uicc.euicc.EuiccPort) this)
+                    .mSupportedMepMode;
+        }
+        if (mepMode == null || !mepMode.isMepA1Mode()) {
+            mepMode = UiccController.getInstance().getSupportedMepMode(mPhysicalSlotIndex);
+        }
+        if (mepMode == null || !mepMode.isMepA1Mode()) {
+            return data;
+        }
+        try {
+            com.android.internal.telephony.uicc.asn1.Asn1Decoder decoder =
+                    new com.android.internal.telephony.uicc.asn1.Asn1Decoder(
+                            IccUtils.hexStringToBytes(data));
+            if (!decoder.hasNextNode()) {
+                return data;
+            }
+            com.android.internal.telephony.uicc.asn1.Asn1Node root = decoder.nextNode();
+            if (root.getTag() != 0xBF31 || root.hasChild(0x82)) {
+                return data;
+            }
+            com.android.internal.telephony.uicc.asn1.Asn1Node.Builder builder =
+                    com.android.internal.telephony.uicc.asn1.Asn1Node.newBuilder(0xBF31);
+            for (com.android.internal.telephony.uicc.asn1.Asn1Node child : root.getChildren()) {
+                builder.addChild(child);
+            }
+            int targetPort = PortUtils.convertToHalPortIndex(mepMode, mPortIdx);
+            builder.addChildAsInteger(0x82, targetPort);
+            String patched = builder.build().toHex();
+            log("maybeAddMepA1TargetPort: injected targetPort=" + targetPort
+                    + " for slot=" + mPhysicalSlotIndex + " port=" + mPortIdx);
+            return patched;
+        } catch (com.android.internal.telephony.uicc.asn1.InvalidAsn1DataException
+                | IllegalArgumentException e) {
+            loge("maybeAddMepA1TargetPort failed: " + e);
+            return data;
+        }
+    }
+
