<?xml version="1.0" encoding="UTF-8"?>
<manifest>
    <!--
        Evolution X 12.4 (Android 17, branch `cnb`, release `cp2a`) local manifest
        for Xiaomi 14T (degas, MT6897).

        Place as: .repo/local_manifests/evox-degas-cnb.xml
        Clone or symlink this device tree to: device/xiaomi/degas
        Then run: repo sync -c (see README.md for full sync flags)

        Phase 1 (vendor_boot.img bring-up) only needs:
          - device/xiaomi/degas          (this tree, branch cnb)
          - device/xiaomi/degas-kernel   (prebuilt GKI kernel, dtb, ramdisk modules)
          - hardware/mediatek            (Evolution-X-Devices/hardware_mediatek cnb)
          - hardware/xiaomi              (Evolution-X-Devices/hardware_xiaomi cnb)
          - device/mediatek/sepolicy_vndr (Evolution-X-Devices/device_mediatek_sepolicy_vndr cnb)

        NOTE: `evo-devices` and `github-non-los` remotes are already declared by
        Evolution-X/manifest (snippets/evolution.xml). The projects below are ALSO
        already declared by the base manifest — do NOT re-declare them here:
          - vendor/qcom/opensource/vibrator   (snippets/lineage.xml)
          - hardware/lineage/compat           (snippets/evolution.xml)
          - hardware/lineage/interfaces       (snippets/lineage.xml)
          - hardware/google/pixel             (snippets/evolution.xml)
          - external/wpa_supplicant_8         (default.xml, lineage-24.0)

        Phase 2 (full ROM):
          - Extract vendor/xiaomi/degas from OS3.0.4.0.WNEMIXM (see patches/README.md
            for Android 17 Keymint V3 / Codec2 -v34 / libsink-mtk / mnld requirements).
          - Cherry-pick the MTK gen4m WPA3/SAE exemption commit onto Android 17's
            external/wpa_supplicant_8 instead of replacing it with the Android 16 fork.
    -->

    <!-- Prebuilt GKI kernel, DTB and kernel modules -->
    <project path="device/xiaomi/degas-kernel"
             name="degas-developers/android_device_xiaomi_degas-kernel"
             remote="github-non-los"
             revision="lineage-23.2"
             clone-depth="1" />

    <!-- Common MT6897 / Xiaomi HALs & vendor sepolicy (Evolution X Android 17 cnb) -->
    <project path="hardware/mediatek"
             name="hardware_mediatek"
             remote="evo-devices"
             revision="cnb" />

    <project path="hardware/xiaomi"
             name="hardware_xiaomi"
             remote="evo-devices"
             revision="cnb" />

    <project path="device/mediatek/sepolicy_vndr"
             name="device_mediatek_sepolicy_vndr"
             remote="evo-devices"
             revision="cnb" />
</manifest>
