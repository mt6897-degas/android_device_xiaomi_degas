type hal_misys_vendor_default, domain;
type hal_misys_vendor_default_exec, exec_type, vendor_file_type, file_type;

init_daemon_domain(hal_misys_vendor_default)

binder_use(hal_misys_vendor_default)

hal_client_domain(hal_misys_vendor_default, hal_misys_vendor)
hal_server_domain(hal_misys_vendor_default, hal_misys_vendor)

hal_client_domain(hal_misys_vendor_default, hal_misyscore)

allow hal_misys_vendor_default self:capability { chown fsetid };

allow hal_misys_vendor_default mnt_vendor_file:dir search;
create_dir_file(hal_misys_vendor_default, persist_data_file)

allow hal_misys_vendor_default vendor_data_file:dir create_dir_perms;
allow hal_misys_vendor_default vendor_data_file:file { create_file_perms map };

allow hal_misys_vendor_default appdomain_tmpfs:file { read write getattr setattr map open };
allow hal_misys_vendor_default tmpfs:dir search;
allow hal_misys_vendor_default tmpfs:file rw_file_perms;
get_prop(hal_misys_vendor_default, vendor_default_prop)

dontaudit hal_misys_vendor_default boot_status_prop:file r_file_perms;
